<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =====================================================================
         AEMX 기본 테마 (라이트)
         Material3 DayNight 기반이며, 색은 colors.xml의 시맨틱 이름만 참조한다.
         다크 모드 색은 values-night/colors.xml 이 자동으로 치환해 준다.
         ===================================================================== -->
    <style name="Theme.AEMX" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- 브랜드 색 -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/color_on_primary_container</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>

        <!-- 배경과 표면 -->
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/color_text_secondary</item>

        <!-- 오류 / 외곽선 -->
        <item name="colorError">@color/color_danger</item>
        <item name="colorOutline">@color/color_stroke</item>

        <!-- 시스템 바 -->
        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:navigationBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Android 15 강제 edge-to-edge 해제: 툴바가 상태바에 겹치지 않게 한다 -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>

        <!-- Material3 기본 팔레트가 브랜드 색과 충돌하지 않도록 파생 색을 맞춘다 -->
        <item name="colorSecondaryContainer">@color/color_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/color_on_primary_container</item>
        <item name="colorErrorContainer">@color/color_danger_bg</item>
        <item name="colorOnErrorContainer">@color/color_danger</item>
        <item name="colorOutlineVariant">@color/color_divider</item>
        <item name="colorSurfaceContainerLowest">@color/color_surface</item>
        <item name="colorSurfaceContainerLow">@color/color_surface</item>
        <item name="colorSurfaceContainer">@color/color_surface</item>
        <item name="colorSurfaceContainerHigh">@color/color_surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/color_surface_variant</item>
        <!-- 다크 모드에서 표면에 자동 틴트가 얹히지 않도록 끈다 -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- 별도 style 지정이 없는 컴포넌트도 앱 디자인을 따르도록 기본값을 건다 -->
        <item name="materialButtonStyle">@style/Widget.AEMX.Button</item>
        <item name="textInputStyle">@style/Widget.AEMX.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.AEMX.Card</item>
        <item name="chipStyle">@style/Widget.AEMX.Chip</item>
    </style>

    <!-- 스플래시 전용 테마: 브랜드 그라데이션 배경 + 밝은 상태바 아이콘 -->
    <style name="Theme.AEMX.Splash" parent="Theme.AEMX">
        <item name="android:statusBarColor">@color/brand_600</item>
        <item name="android:navigationBarColor">@color/brand_600</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@drawable/bg_gradient_brand</item>
    </style>

    <!-- =====================================================================
         텍스트 스타일 — 레이아웃에서 style="@style/TextAppearance.AEMX.*" 로 참조
         ===================================================================== -->

    <!-- 가장 큰 제목 (스플래시 앱 이름 등) -->
    <style name="TextAppearance.AEMX.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <!-- 화면 상단 헤드라인 -->
    <style name="TextAppearance.AEMX.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <!-- 카드/섹션 제목 -->
    <style name="TextAppearance.AEMX.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <!-- 본문 -->
    <style name="TextAppearance.AEMX.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body_l</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <!-- 보조 설명 문구 -->
    <style name="TextAppearance.AEMX.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <!-- 작은 캡션 (시간, 부가 정보) -->
    <style name="TextAppearance.AEMX.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/color_text_tertiary</item>
    </style>

    <!-- 설정 화면의 섹션 라벨 (자간을 넓혀 구분감을 준다) -->
    <style name="TextAppearance.AEMX.SectionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- =====================================================================
         컴포넌트 스타일
         ===================================================================== -->

    <!-- 기본 채움 버튼 -->
    <style name="Widget.AEMX.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">@dimen/elevation_none</item>
        <item name="android:insetBottom">@dimen/elevation_none</item>
        <item name="cornerRadius">@dimen/radius_s</item>
        <item name="android:textSize">@dimen/text_body_l</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <!-- 테두리 버튼 (보조 동작) -->
    <style name="Widget.AEMX.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">@dimen/elevation_none</item>
        <item name="android:insetBottom">@dimen/elevation_none</item>
        <item name="cornerRadius">@dimen/radius_s</item>
        <item name="android:textSize">@dimen/text_body_l</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="strokeColor">@color/color_stroke</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
    </style>

    <!-- 텍스트 버튼 (약한 강조) -->
    <style name="Widget.AEMX.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">@dimen/radius_s</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <!-- 입력 필드 (외곽선 박스) -->
    <style name="Widget.AEMX.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_s</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_s</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_s</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_s</item>
        <item name="boxStrokeWidth">@dimen/stroke_width</item>
    </style>

    <!-- 카드 (그림자 없이 얇은 테두리로 구분) -->
    <style name="Widget.AEMX.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_m</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeColor">@color/color_stroke</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="cardBackgroundColor">@color/color_surface</item>
    </style>

    <!-- 필터 칩 -->
    <style name="Widget.AEMX.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">@dimen/text_body</item>
    </style>

</resources>
