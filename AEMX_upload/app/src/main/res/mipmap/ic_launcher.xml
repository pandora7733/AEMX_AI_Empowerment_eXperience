<?xml version="1.0" encoding="utf-8"?>
<!--
  API 24~25 폴백 런처 아이콘.
  적응형 아이콘을 지원하지 않는 기기에서는 배경 위에 전경을 겹쳐 그린 이 레이어 목록이 쓰인다.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 브랜드 배경 면 -->
    <item android:drawable="@drawable/ic_launcher_background" />

    <!-- 방패 전경 (가장자리에 여백을 두어 잘려 보이지 않게 한다) -->
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:bottom="@dimen/space_xs"
        android:left="@dimen/space_xs"
        android:right="@dimen/space_xs"
        android:top="@dimen/space_xs" />
</layer-list>
