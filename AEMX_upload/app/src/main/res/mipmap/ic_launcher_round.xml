<?xml version="1.0" encoding="utf-8"?>
<!--
  API 24~25 폴백 런처 아이콘(원형 요청용).
  구형 런처가 둥근 아이콘을 요청할 때 사용되며, 구성은 기본 폴백 아이콘과 동일하다.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 브랜드 배경 면 -->
    <item android:drawable="@drawable/ic_launcher_background" />

    <!-- 방패 전경 (원형 마스크에 잘리지 않도록 안쪽으로 조금 더 들여 그린다) -->
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:bottom="@dimen/space_s"
        android:left="@dimen/space_s"
        android:right="@dimen/space_s"
        android:top="@dimen/space_s" />
</layer-list>
