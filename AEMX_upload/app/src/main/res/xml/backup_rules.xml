<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11(API 30) 이하에서 사용하는 자동 백업 규칙.
    자격 증명에 해당하는 보안 설정 파일은 백업에서 제외한다.
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="aemx_secure_prefs.xml" />
    <exclude
        domain="file"
        path="credentials" />
</full-backup-content>
