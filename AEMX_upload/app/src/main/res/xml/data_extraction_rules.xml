<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12(API 31) 이상의 데이터 추출 규칙.
    cloud-backup: 클라우드 백업 시 제외 대상
    device-transfer: 기기 간 이전 시 제외 대상
    두 경우 모두 로그인 자격 증명 관련 파일은 내보내지 않는다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="aemx_secure_prefs.xml" />
        <exclude
            domain="file"
            path="credentials" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="aemx_secure_prefs.xml" />
        <exclude
            domain="file"
            path="credentials" />
    </device-transfer>
</data-extraction-rules>
