<?xml version="1.0" encoding="utf-8"?><!-- 계정 탭: 검색창 + 필터 칩 + 계정 목록(비었을 때는 빈 상태 뷰) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_horizontal_padding"
    android:paddingEnd="@dimen/screen_horizontal_padding"
    tools:context=".ui.accounts.AccountsFragment">

    <!-- 검색창 (실제 검색은 동작하지 않는 껍데기) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAccountsSearch"
        style="@style/Widget.AEMX.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:hint="@string/accounts_search_hint"
        app:startIconContentDescription="@string/action_search"
        app:startIconDrawable="@drawable/ic_search_24"
        app:startIconTint="@color/color_icon_tint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAccountsSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="@dimen/text_body_l" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- 필터 칩: 전체 / 자동 로그인 / 수동 -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        app:chipSpacingHorizontal="@dimen/space_xs"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFilterAll"
            style="@style/Widget.AEMX.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/accounts_filter_all" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFilterAuto"
            style="@style/Widget.AEMX.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/accounts_filter_auto" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFilterManual"
            style="@style/Widget.AEMX.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/accounts_filter_manual" />

    </com.google.android.material.chip.ChipGroup>

    <!-- 목록 개수 안내 -->
    <TextView
        android:id="@+id/tvAccountsCount"
        style="@style/TextAppearance.AEMX.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginBottom="@dimen/space_xs"
        android:text="@string/accounts_count_format"
        tools:text="총 12개의 계정" />

    <!-- 목록 영역: 계정이 있으면 rvAccounts, 없으면 layoutEmpty 를 보여준다 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAccounts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/list_bottom_padding"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="5"
            tools:listitem="@layout/item_account" />

        <include
            android:id="@+id/layoutEmpty"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="gone" />

    </FrameLayout>

</LinearLayout>
