<?xml version="1.0" encoding="utf-8"?><!-- 목록이 비었을 때 보여주는 공용 빈 상태 뷰 (include 로 재사용) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_xxl"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_xxl">

    <!-- 빈 상자 일러스트 -->
    <ImageView
        android:id="@+id/ivEmptyIcon"
        android:layout_width="@dimen/icon_xl"
        android:layout_height="@dimen/icon_xl"
        android:contentDescription="@string/cd_empty_illustration"
        android:src="@drawable/ic_empty_box_24"
        app:tint="@color/color_text_tertiary" />

    <TextView
        android:id="@+id/tvEmptyTitle"
        style="@style/TextAppearance.AEMX.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center"
        android:text="@string/empty_title"
        tools:text="저장된 계정이 없어요" />

    <TextView
        android:id="@+id/tvEmptyDesc"
        style="@style/TextAppearance.AEMX.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/space_xxs"
        android:text="@string/empty_desc"
        tools:text="자주 쓰는 사이트를 등록하면\n앱이 대신 로그인해 드릴게요" />

    <!-- 첫 계정 추가 유도 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptyAction"
        style="@style/Widget.AEMX.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:text="@string/empty_action"
        app:icon="@drawable/ic_add_24"
        app:iconSize="@dimen/icon_s" />

</LinearLayout>
