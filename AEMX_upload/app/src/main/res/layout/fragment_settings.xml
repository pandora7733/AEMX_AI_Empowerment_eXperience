<?xml version="1.0" encoding="utf-8"?>
<!-- 설정 화면: 프로필 / 보안 / 일반 / 정보 섹션 + 로그아웃 (SettingsFragment.java 에서 사용) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".ui.settings.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/space_xxl">

        <!-- ===== 프로필 카드 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfile"
            style="@style/Widget.AEMX.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_m">

                <!-- 프로필 이미지 (원형 배경 + 사람 아이콘) -->
                <ImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="@dimen/avatar_l"
                    android:layout_height="@dimen/avatar_l"
                    android:background="@drawable/bg_circle_primary"
                    android:contentDescription="@string/cd_profile_image"
                    android:padding="@dimen/space_s"
                    android:src="@drawable/ic_person_24"
                    app:tint="@color/color_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        style="@style/TextAppearance.AEMX.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_profile_name" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        style="@style/TextAppearance.AEMX.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_profile_email" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    style="@style/Widget.AEMX.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:insetTop="@dimen/elevation_none"
                    android:insetBottom="@dimen/elevation_none"
                    android:maxLines="1"
                    android:minWidth="@dimen/elevation_none"
                    android:text="@string/settings_edit_profile" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 보안 섹션 ===== -->
        <TextView
            android:id="@+id/tvSectionSecurity"
            style="@style/TextAppearance.AEMX.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xxs"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_xs"
            android:text="@string/settings_section_security" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSecurity"
            style="@style/Widget.AEMX.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 자동 로그인 사용 (스위치 행) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_m"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.AEMX.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_auto_login" />

                        <TextView
                            android:id="@+id/tvSettingAutoLoginDesc"
                            style="@style/TextAppearance.AEMX.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/settings_auto_login_desc" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSettingAutoLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:checked="true"
                        android:contentDescription="@string/settings_auto_login" />

                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/color_divider"
                    app:dividerInsetStart="@dimen/space_m"
                    app:dividerThickness="@dimen/stroke_width" />

                <!-- 생체인증 잠금 (스위치 행) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_m"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.AEMX.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_biometric" />

                        <TextView
                            android:id="@+id/tvSettingBiometricDesc"
                            style="@style/TextAppearance.AEMX.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/settings_biometric_desc" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSettingBiometric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:contentDescription="@string/settings_biometric" />

                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/color_divider"
                    app:dividerInsetStart="@dimen/space_m"
                    app:dividerThickness="@dimen/stroke_width" />

                <!-- 자동 잠금 시간 (값 + 화살표 행) -->
                <LinearLayout
                    android:id="@+id/rowLockTimeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_m"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s">

                    <TextView
                        android:id="@+id/tvLockTimeoutLabel"
                        style="@style/TextAppearance.AEMX.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_lock_timeout" />

                    <TextView
                        android:id="@+id/tvLockTimeoutValue"
                        style="@style/TextAppearance.AEMX.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:text="@string/settings_lock_timeout_value" />

                    <ImageView
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:layout_marginStart="@dimen/space_xxs"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/color_text_tertiary" />

                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/color_divider"
                    app:dividerInsetStart="@dimen/space_m"
                    app:dividerThickness="@dimen/stroke_width" />

                <!-- 마스터 비밀번호 변경 (이동 행) -->
                <LinearLayout
                    android:id="@+id/rowChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_m"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s">

                    <TextView
                        android:id="@+id/tvChangePasswordLabel"
                        style="@style/TextAppearance.AEMX.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_change_password" />

                    <ImageView
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:layout_marginStart="@dimen/space_xs"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/color_text_tertiary" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 일반 섹션 ===== -->
        <TextView
            android:id="@+id/tvSectionGeneral"
            style="@style/TextAppearance.AEMX.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xxs"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_xs"
            android:text="@string/settings_section_general" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGeneral"
            style="@style/Widget.AEMX.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 다크 모드 (스위치 행) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_m"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.AEMX.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_dark_mode" />

                        <TextView
                            android:id="@+id/tvSettingDarkModeDesc"
                            style="@style/TextAppearance.AEMX.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/settings_dark_mode_desc" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSettingDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:contentDescription="@string/settings_dark_mode" />

                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/color_divider"
                    app:dividerInsetStart="@dimen/space_m"
                    app:dividerThickness="@dimen/stroke_width" />

                <!-- 알림 받기 (스위치 행) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_m"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.AEMX.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_notification" />

                        <TextView
                            android:id="@+id/tvSettingNotificationDesc"
                            style="@style/TextAppearance.AEMX.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/settings_notification_desc" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSettingNotification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:checked="true"
                        android:contentDescription="@string/settings_notification" />

                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/color_divider"
                    app:dividerInsetStart="@dimen/space_m"
                    app:dividerThickness="@dimen/stroke_width" />

                <!-- 언어 (값 + 화살표 행) -->
                <LinearLayout
                    android:id="@+id/rowLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_m"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s">

                    <TextView
                        android:id="@+id/tvLanguageLabel"
                        style="@style/TextAppearance.AEMX.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_language" />

                    <TextView
                        android:id="@+id/tvLanguageValue"
                        style="@style/TextAppearance.AEMX.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:text="@string/settings_language_value" />

                    <ImageView
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:layout_marginStart="@dimen/space_xxs"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/color_text_tertiary" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 정보 섹션 ===== -->
        <TextView
            android:id="@+id/tvSectionInfo"
            style="@style/TextAppearance.AEMX.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xxs"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_xs"
            android:text="@string/settings_section_info" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInfo"
            style="@style/Widget.AEMX.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 앱 버전 (값만 표시하는 행) -->
                <LinearLayout
                    android:id="@+id/rowVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_m"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s">

                    <TextView
                        android:id="@+id/tvVersionLabel"
                        style="@style/TextAppearance.AEMX.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_version" />

                    <TextView
                        android:id="@+id/tvVersionValue"
                        style="@style/TextAppearance.AEMX.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:text="@string/app_version" />

                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/color_divider"
                    app:dividerInsetStart="@dimen/space_m"
                    app:dividerThickness="@dimen/stroke_width" />

                <!-- 오픈소스 라이선스 (이동 행) -->
                <LinearLayout
                    android:id="@+id/rowOpenSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_m"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s">

                    <TextView
                        android:id="@+id/tvOpenSourceLabel"
                        style="@style/TextAppearance.AEMX.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_open_source" />

                    <ImageView
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:layout_marginStart="@dimen/space_xs"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/color_text_tertiary" />

                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/color_divider"
                    app:dividerInsetStart="@dimen/space_m"
                    app:dividerThickness="@dimen/stroke_width" />

                <!-- 개인정보 처리방침 (이동 행) -->
                <LinearLayout
                    android:id="@+id/rowPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_m"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s">

                    <TextView
                        android:id="@+id/tvPrivacyLabel"
                        style="@style/TextAppearance.AEMX.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_privacy" />

                    <ImageView
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:layout_marginStart="@dimen/space_xs"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/color_text_tertiary" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 로그아웃 / 회원 탈퇴 ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.AEMX.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/settings_logout"
            app:icon="@drawable/ic_logout_24"
            app:iconGravity="textStart"
            app:iconSize="@dimen/icon_s" />

        <TextView
            android:id="@+id/tvDeleteAccount"
            style="@style/TextAppearance.AEMX.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="@dimen/space_s"
            android:text="@string/settings_delete_account"
            android:textColor="@color/color_danger" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
