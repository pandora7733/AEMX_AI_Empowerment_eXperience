<?xml version="1.0" encoding="utf-8"?><!-- 계정 목록 RecyclerView 의 카드 한 장 -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.AEMX.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_s">

        <!-- 사이트 아이콘 -->
        <ImageView
            android:id="@+id/ivSiteIcon"
            android:layout_width="@dimen/avatar_m"
            android:layout_height="@dimen/avatar_m"
            android:background="@drawable/bg_circle_surface"
            android:contentDescription="@string/cd_site_icon"
            android:padding="@dimen/space_s"
            android:src="@drawable/ic_globe_24"
            app:tint="@color/color_icon_tint" />

        <!-- 사이트 이름 + 배지 + 아이디 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSiteName"
                    style="@style/TextAppearance.AEMX.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textStyle="bold"
                    tools:text="네이버" />

                <!-- 자동/수동 배지 (코드에서 배경과 문구를 바꾼다) -->
                <TextView
                    android:id="@+id/tvSiteBadge"
                    style="@style/TextAppearance.AEMX.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:background="@drawable/bg_pill_success"
                    android:maxLines="1"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingTop="@dimen/space_xxs"
                    android:paddingEnd="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_xxs"
                    android:text="@string/accounts_badge_auto"
                    android:textColor="@color/color_success"
                    tools:text="자동" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvSiteAccountId"
                style="@style/TextAppearance.AEMX.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="hong.gildong@example.com" />

        </LinearLayout>

        <!-- 자동 로그인 on/off -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAccountAutoLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:contentDescription="@string/accounts_auto_login_switch"
            tools:checked="true" />

        <!-- 상세 화면 진입 표시 -->
        <ImageView
            android:id="@+id/ivAccountChevron"
            android:layout_width="@dimen/icon_m"
            android:layout_height="@dimen/icon_m"
            android:layout_marginStart="@dimen/space_xxs"
            android:contentDescription="@string/cd_open_detail"
            android:src="@drawable/ic_chevron_right_24"
            app:tint="@color/color_text_tertiary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
