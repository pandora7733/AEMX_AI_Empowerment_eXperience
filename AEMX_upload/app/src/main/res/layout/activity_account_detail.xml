<?xml version="1.0" encoding="utf-8"?>
<!-- 계정 상세 화면: 사이트 헤더 / 로그인 정보 / 자동 로그인 / 기록 (AccountDetailActivity.kt 에서 사용) -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".ui.accounts.AccountDetailActivity">

    <!-- 상단 앱바 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_background"
        app:elevation="@dimen/elevation_none"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_background"
            app:navigationContentDescription="@string/action_back"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:navigationIconTint="@color/color_text_primary"
            app:title="@string/detail_title"
            app:titleCentered="false"
            app:titleTextColor="@color/color_text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/screen_horizontal_padding"
            android:paddingBottom="@dimen/space_xxl">

            <!-- ===== 사이트 헤더 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivDetailSiteIcon"
                    android:layout_width="@dimen/avatar_l"
                    android:layout_height="@dimen/avatar_l"
                    android:background="@drawable/bg_circle_primary"
                    android:contentDescription="@string/cd_site_icon"
                    android:padding="@dimen/space_s"
                    android:src="@drawable/ic_globe_24"
                    app:tint="@color/color_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDetailSiteName"
                        style="@style/TextAppearance.AEMX.Headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="네이버" />

                    <TextView
                        android:id="@+id/tvDetailSiteUrl"
                        style="@style/TextAppearance.AEMX.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="https://www.naver.com" />

                </LinearLayout>

                <!-- 자동/수동 배지 -->
                <TextView
                    android:id="@+id/tvDetailBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:background="@drawable/bg_pill_success"
                    android:paddingStart="@dimen/space_s"
                    android:paddingTop="@dimen/space_xxs"
                    android:paddingEnd="@dimen/space_s"
                    android:paddingBottom="@dimen/space_xxs"
                    android:text="@string/accounts_badge_auto"
                    android:textColor="@color/color_success"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ===== 로그인 정보 ===== -->
            <TextView
                android:id="@+id/tvSectionCredentials"
                style="@style/TextAppearance.AEMX.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xxs"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/detail_section_credentials" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCredentials"
                style="@style/Widget.AEMX.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 아이디 행 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_row_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_m"
                        android:paddingTop="@dimen/space_s"
                        android:paddingEnd="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_s">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDetailIdLabel"
                                style="@style/TextAppearance.AEMX.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/detail_label_id" />

                            <TextView
                                android:id="@+id/tvDetailId"
                                style="@style/TextAppearance.AEMX.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:ellipsize="end"
                                android:maxLines="1"
                                tools:text="aemx_demo" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyId"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/detail_copy_id"
                            app:icon="@drawable/ic_copy_24"
                            app:iconSize="@dimen/icon_m"
                            app:iconTint="@color/color_icon_tint" />

                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dividerColor="@color/color_divider"
                        app:dividerInsetStart="@dimen/space_m"
                        app:dividerThickness="@dimen/stroke_width" />

                    <!-- 비밀번호 행 (표시 토글 + 복사) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_row_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_m"
                        android:paddingTop="@dimen/space_s"
                        android:paddingEnd="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_s">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDetailPasswordLabel"
                                style="@style/TextAppearance.AEMX.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/detail_label_password" />

                            <TextView
                                android:id="@+id/tvDetailPassword"
                                style="@style/TextAppearance.AEMX.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/detail_password_masked" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTogglePassword"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/detail_toggle_password"
                            app:icon="@drawable/ic_visibility_24"
                            app:iconSize="@dimen/icon_m"
                            app:iconTint="@color/color_icon_tint" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyPassword"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/detail_copy_password"
                            app:icon="@drawable/ic_copy_24"
                            app:iconSize="@dimen/icon_m"
                            app:iconTint="@color/color_icon_tint" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 이 사이트 자동 로그인 ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAutoLogin"
                style="@style/Widget.AEMX.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_height"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDetailAutoLoginTitle"
                            style="@style/TextAppearance.AEMX.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_auto_login"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailAutoLoginDesc"
                            style="@style/TextAppearance.AEMX.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/detail_auto_login_desc" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDetailAutoLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:checked="true"
                        android:contentDescription="@string/detail_auto_login" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 기록 ===== -->
            <TextView
                android:id="@+id/tvSectionDetailInfo"
                style="@style/TextAppearance.AEMX.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xxs"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/detail_section_info" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDetailInfo"
                style="@style/Widget.AEMX.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 마지막 사용 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_row_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_m"
                        android:paddingTop="@dimen/space_s"
                        android:paddingEnd="@dimen/space_m"
                        android:paddingBottom="@dimen/space_s">

                        <TextView
                            android:id="@+id/tvDetailLastUsedLabel"
                            style="@style/TextAppearance.AEMX.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_label_last_used" />

                        <TextView
                            android:id="@+id/tvDetailLastUsedValue"
                            style="@style/TextAppearance.AEMX.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            tools:text="3분 전" />

                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dividerColor="@color/color_divider"
                        app:dividerInsetStart="@dimen/space_m"
                        app:dividerThickness="@dimen/stroke_width" />

                    <!-- 등록일 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_row_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_m"
                        android:paddingTop="@dimen/space_s"
                        android:paddingEnd="@dimen/space_m"
                        android:paddingBottom="@dimen/space_s">

                        <TextView
                            android:id="@+id/tvDetailCreatedLabel"
                            style="@style/TextAppearance.AEMX.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_label_created" />

                        <TextView
                            android:id="@+id/tvDetailCreatedValue"
                            style="@style/TextAppearance.AEMX.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            tools:text="2026. 01. 12." />

                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dividerColor="@color/color_divider"
                        app:dividerInsetStart="@dimen/space_m"
                        app:dividerThickness="@dimen/stroke_width" />

                    <!-- 분류 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_row_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_m"
                        android:paddingTop="@dimen/space_s"
                        android:paddingEnd="@dimen/space_m"
                        android:paddingBottom="@dimen/space_s">

                        <TextView
                            android:id="@+id/tvDetailCategoryLabel"
                            style="@style/TextAppearance.AEMX.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_label_category" />

                        <TextView
                            android:id="@+id/tvDetailCategoryValue"
                            style="@style/TextAppearance.AEMX.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            tools:text="SNS" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 하단 액션 ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSite"
                style="@style/Widget.AEMX.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/detail_open_site"
                app:icon="@drawable/ic_link_24"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_s" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailDelete"
                style="@style/Widget.AEMX.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/action_delete"
                android:textColor="@color/color_danger"
                app:icon="@drawable/ic_delete_24"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_s"
                app:iconTint="@color/color_danger" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
