<?xml version="1.0" encoding="utf-8"?>
<!-- 회원가입 화면: 상단 툴바 + 스크롤되는 입력 폼. 마스터 계정 하나를 만드는 흐름이다. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".ui.auth.SignUpActivity">

    <!-- 상단 앱바 : 그림자 없이 배경과 같은 색으로 붙여 평평한 인상을 준다 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_background"
        app:elevation="@dimen/elevation_none"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarSignUp"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_background"
            app:navigationContentDescription="@string/action_back"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:navigationIconTint="@color/color_text_primary"
            app:title="@string/sign_up_title"
            app:titleCentered="false"
            app:titleTextColor="@color/color_text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/screen_horizontal_padding"
            android:paddingBottom="@dimen/space_xxl">

            <!-- 헤드라인 / 부제 -->
            <TextView
                android:id="@+id/tvSignUpHeadline"
                style="@style/TextAppearance.AEMX.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sign_up_headline" />

            <TextView
                android:id="@+id/tvSignUpSubtitle"
                style="@style/TextAppearance.AEMX.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/sign_up_subtitle" />

            <!-- 이름 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSignUpName"
                style="@style/Widget.AEMX.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:hint="@string/sign_up_hint_name"
                app:startIconContentDescription="@string/sign_up_hint_name"
                app:startIconDrawable="@drawable/ic_person_24"
                app:startIconTint="@color/color_icon_tint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSignUpName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:textSize="@dimen/text_body_l"
                    tools:text="홍길동" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- 이메일 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSignUpEmail"
                style="@style/Widget.AEMX.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:hint="@string/sign_up_hint_email"
                app:startIconContentDescription="@string/sign_up_hint_email"
                app:startIconDrawable="@drawable/ic_link_24"
                app:startIconTint="@color/color_icon_tint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSignUpEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textSize="@dimen/text_body_l"
                    tools:text="aemx.demo@example.com" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- 비밀번호 (조건 안내 문구 포함) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSignUpPassword"
                style="@style/Widget.AEMX.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:hint="@string/sign_up_hint_password"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/color_icon_tint"
                app:helperText="@string/sign_up_helper_password"
                app:helperTextTextColor="@color/color_text_secondary"
                app:startIconContentDescription="@string/sign_up_hint_password"
                app:startIconDrawable="@drawable/ic_lock_24"
                app:startIconTint="@color/color_icon_tint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSignUpPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="@dimen/text_body_l" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- 비밀번호 확인 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSignUpPasswordConfirm"
                style="@style/Widget.AEMX.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:hint="@string/sign_up_hint_password_confirm"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/color_icon_tint"
                app:startIconContentDescription="@string/sign_up_hint_password_confirm"
                app:startIconDrawable="@drawable/ic_lock_24"
                app:startIconTint="@color/color_icon_tint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSignUpPasswordConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="@dimen/text_body_l" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- 약관 동의 -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbSignUpTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:minHeight="@dimen/icon_l"
                android:text="@string/sign_up_terms"
                android:textAppearance="@style/TextAppearance.AEMX.Secondary" />

            <!-- 가입 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignUp"
                style="@style/Widget.AEMX.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/sign_up_button" />

            <!-- 로그인으로 돌아가기 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGoLoginLabel"
                    style="@style/TextAppearance.AEMX.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_up_go_login" />

                <TextView
                    android:id="@+id/tvGoLogin"
                    style="@style/TextAppearance.AEMX.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/space_xxs"
                    android:text="@string/sign_up_go_login_action"
                    android:textColor="@color/color_primary"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
