<?xml version="1.0" encoding="utf-8"?><!-- 홈 탭: 인사말 + 보호 상태 카드 + 통계 3종 + 최근 활동 목록 -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/space_xxl">

        <!-- ===== 인사말 ===== -->
        <TextView
            android:id="@+id/tvHomeGreeting"
            style="@style/TextAppearance.AEMX.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_greeting"
            tools:text="안녕하세요, 홍길동님" />

        <TextView
            android:id="@+id/tvHomeGreetingSub"
            style="@style/TextAppearance.AEMX.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:text="@string/home_greeting_sub"
            tools:text="오늘도 안전하게 로그인하세요" />

        <!-- ===== 자동 로그인 보호 상태 카드 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHomeStatus"
            style="@style/Widget.AEMX.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:cardBackgroundColor="@color/color_primary_container"
            app:strokeWidth="@dimen/elevation_none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivHomeStatusIcon"
                        android:layout_width="@dimen/avatar_s"
                        android:layout_height="@dimen/avatar_s"
                        android:background="@drawable/bg_circle_surface"
                        android:contentDescription="@string/cd_status_icon"
                        android:padding="@dimen/space_xs"
                        android:src="@drawable/ic_shield_24"
                        app:tint="@color/color_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHomeStatusTitle"
                            style="@style/TextAppearance.AEMX.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_status_title"
                            android:textColor="@color/color_on_primary_container"
                            android:textStyle="bold"
                            tools:text="자동 로그인 보호 중" />

                        <TextView
                            android:id="@+id/tvHomeStatusValue"
                            style="@style/TextAppearance.AEMX.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/home_status_value"
                            tools:text="12개 사이트가 연결되어 있어요" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 동기화 버튼 (동작은 준비 중 안내만) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHomeSync"
                    style="@style/Widget.AEMX.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:text="@string/home_status_action"
                    tools:text="지금 동기화" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 통계 카드 3개: 가로 3등분 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatAccounts"
                style="@style/Widget.AEMX.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_s">

                    <TextView
                        android:id="@+id/tvStatAccountsValue"
                        style="@style/TextAppearance.AEMX.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/home_stat_accounts_value"
                        tools:text="12" />

                    <TextView
                        android:id="@+id/tvStatAccountsLabel"
                        style="@style/TextAppearance.AEMX.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/home_stat_accounts_label"
                        tools:text="저장된 계정" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatAuto"
                style="@style/Widget.AEMX.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_s">

                    <TextView
                        android:id="@+id/tvStatAutoValue"
                        style="@style/TextAppearance.AEMX.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/home_stat_auto_value"
                        android:textColor="@color/color_primary"
                        tools:text="8" />

                    <TextView
                        android:id="@+id/tvStatAutoLabel"
                        style="@style/TextAppearance.AEMX.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/home_stat_auto_label"
                        tools:text="자동 로그인" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatSync"
                style="@style/Widget.AEMX.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_s">

                    <TextView
                        android:id="@+id/tvStatSyncValue"
                        style="@style/TextAppearance.AEMX.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/home_stat_sync_value"
                        tools:text="3분 전" />

                    <TextView
                        android:id="@+id/tvStatSyncLabel"
                        style="@style/TextAppearance.AEMX.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/home_stat_sync_label"
                        tools:text="마지막 동기화" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ===== 최근 활동 헤더 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHomeRecentTitle"
                style="@style/TextAppearance.AEMX.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_recent_title"
                tools:text="최근 활동" />

            <TextView
                android:id="@+id/tvHomeSeeAll"
                style="@style/TextAppearance.AEMX.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/space_xs"
                android:paddingTop="@dimen/space_xxs"
                android:paddingEnd="@dimen/space_xxs"
                android:paddingBottom="@dimen/space_xxs"
                android:text="@string/home_recent_see_all"
                android:textColor="@color/color_primary"
                tools:text="전체 보기" />

        </LinearLayout>

        <!-- ===== 최근 활동 3줄 (코드에서 문구/아이콘을 각각 다르게 채운다) ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AEMX.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_xxs"
                android:paddingBottom="@dimen/space_xxs">

                <include
                    android:id="@+id/recentItem1"
                    layout="@layout/item_recent_activity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_marginEnd="@dimen/space_s"
                    app:dividerColor="@color/color_divider" />

                <include
                    android:id="@+id/recentItem2"
                    layout="@layout/item_recent_activity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_marginEnd="@dimen/space_s"
                    app:dividerColor="@color/color_divider" />

                <include
                    android:id="@+id/recentItem3"
                    layout="@layout/item_recent_activity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
