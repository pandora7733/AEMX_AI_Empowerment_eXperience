<?xml version="1.0" encoding="utf-8"?>
<!--
  런처 아이콘 배경 레이어 (108x108).
  브랜드 색을 기본 면으로 깔고, 위에 옅은 원 두 개를 얹어 밋밋하지 않게 만든다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 기본 브랜드 면 -->
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

    <!-- 우하단을 살짝 어둡게 눌러 대각선 음영을 만든다 -->
    <path
        android:fillAlpha="0.35"
        android:fillColor="@color/brand_700"
        android:pathData="M108,0 L108,108 L0,108 Z" />

    <!-- 좌상단 하이라이트 원 -->
    <path
        android:fillAlpha="0.14"
        android:fillColor="#FFFFFFFF"
        android:pathData="M26,-6 m-34,0 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0 Z" />

    <!-- 우하단 보조 원 -->
    <path
        android:fillAlpha="0.10"
        android:fillColor="#FFFFFFFF"
        android:pathData="M96,100 m-30,0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0 Z" />
</vector>
