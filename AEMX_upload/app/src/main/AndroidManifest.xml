<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 사이트 연결/동기화를 위한 인터넷 권한 (껍데기 단계에서는 선언만 한다) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 생체인증 잠금 해제용 권한 (껍데기 단계에서는 선언만 한다) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AEMX"
        tools:targetApi="31">

        <!-- 앱 진입점: 브랜드 스플래시 화면 -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AEMX.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 로그인 -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 회원가입 (Java 구현) -->
        <activity
            android:name=".ui.auth.SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 하단 탭 3개를 담는 메인 화면 -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <!-- 계정 상세 -->
        <activity
            android:name=".ui.accounts.AccountDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- 계정 추가 (Java 구현) -->
        <activity
            android:name=".ui.accounts.AddAccountActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
