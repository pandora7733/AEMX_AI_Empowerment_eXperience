<?xml version="1.0" encoding="utf-8"?>
<!--
  시작 화면과 앱 로고. 파랑→보라 원 위에 둥근 "a" 를 그린다. 글자를 쓰지 않고 선으로 그려서
  폰트와 상관없이 같은 모양이다. AemxLogoView 의 기울인 글자와 같은 모양은 아니다(기하 근사).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <path
        android:pathData="M60,8 A52,52 0 1,1 60,112 A52,52 0 1,1 60,8 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="120"
                android:endY="120"
                android:type="linear">
                <item android:color="@color/aemx_logo" android:offset="0" />
                <item android:color="@color/aemx_logo_end" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M56,60 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0"
        android:strokeColor="@color/aemx_logo_text"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M72,44 L72,76"
        android:strokeColor="@color/aemx_logo_text"
        android:strokeWidth="9"
        android:strokeLineCap="round" />
</vector>
