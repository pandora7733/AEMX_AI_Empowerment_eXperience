<?xml version="1.0" encoding="utf-8"?><!--
   API 31 이상용 규칙. backup_rules.xml 과 같은 이유로 모델과 화자 등록은 클라우드 백업과
   기기 간 전송에서 뺀다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
        <exclude domain="sharedpref" path="aemx_speaker.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
        <exclude domain="sharedpref" path="aemx_speaker.xml" />
    </device-transfer>
</data-extraction-rules>
