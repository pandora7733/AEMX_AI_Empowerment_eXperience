<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 최초 실행 시 LLM 모델(1.2GB)을 내려받는다. APK 에 넣기엔 너무 커서 다운로드 방식. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 음성 명령을 들으려면 마이크가 필요하다. 실행 중에 사용자에게 물어본다. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 호출어를 화면이 꺼져 있을 때도 들으려면 마이크 사용 포그라운드 서비스가 필요하다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- 문자 보내기: 받는 사람 이름이 연락처에 정확히 한 명 있는지 확인한다. 실행 중에 사용자에게 물어본다. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <queries>
        <!-- 설치된 앱을 이름(런처 라벨)으로 열려고 런처 앱 목록을 본다. QUERY_ALL_PACKAGES 는 쓰지 않는다. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="mok.android" />
        <package android:name="kr.co.aladin.third_shop" />
        <package android:name="com.nhn.android.search" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.instagram.android" />
    </queries>

    <!--
        자동 백업은 끈다(이슈 #16). files/models/ 의 모델(1.2GB)은 앱당 25MB 한도를 넘어 백업 전체가
        건너뛰어지게 만들고, 화자 등록(aemx_speaker)은 목소리 특징이라 "기기 밖으로 보내지 않는다"는
        방침과 맞지 않는다. 아래 규칙 파일에도 같은 항목을 제외해 두었다.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AEMX">

        <!--
            NPU(Hexagon)와 GPU(OpenCL) 백엔드는 제조사가 /vendor 에 넣어 둔 라이브러리를
            연다. 앱은 기본적으로 그쪽을 못 보기 때문에 여기서 쓰겠다고 밝혀야 하고,
            빠뜨리면 모델을 올리는 순간 dlopen 실패로 앱이 죽는다(실기기에서 확인).

            required="false" 인 이유는 이 라이브러리가 없는 기기에서도 설치는 되게
            하려는 것이다. 그런 기기에서는 CPU 로 떨어진다.
        -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".accessibility.ActionPlanActivity" android:exported="false" />

        <!-- 개발용 화면(PipelineDebugActivity)은 릴리스에 넣지 않는다. src/debug/AndroidManifest.xml 에 있다. -->

        <service
            android:name=".accessibility.AemxAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 호출어 듣기. 마이크 사용 유형으로 올려서 화면이 꺼져도 녹음이 끊기지 않는다. -->
        <service
            android:name=".pipeline.app.VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
