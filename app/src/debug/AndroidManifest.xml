<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            개발용 화면이라 디버그 빌드에만 넣는다(이슈 #16). adb 없이 폰에서 바로 열 수 있게 홈 화면
            런처 아이콘도 둔다. 아이콘이 두 개(AEMX, AEMX 개발)가 되는 건 사용자가 원한 것이다.
            아래 adb 명령으로 여는 방법은 그대로 된다.
              adb shell am start -n com.sihoo.aemx/.pipeline.ui.PipelineDebugActivity
        -->
        <activity
            android:name=".pipeline.ui.PipelineDebugActivity"
            android:exported="true"
            android:label="@string/pipeline_title"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!--
            런처 진입점은 액티비티가 아니라 별칭에 둔다. 액티비티 자체의 라벨(화면 제목 "파이프라인
            테스트")을 건드리지 않고 아이콘 이름만 "AEMX 개발"로 구분하려는 것이다.
        -->
        <activity-alias
            android:name=".pipeline.ui.PipelineDebugLauncher"
            android:exported="true"
            android:label="@string/pipeline_launcher_label"
            android:targetActivity=".pipeline.ui.PipelineDebugActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
